; 深渊回响 — Godot 4 + C# 移植版
;
; 这一份不是 TS 版的翻译，而是「同一套规则换个引擎重写」：
; 逻辑层（Rng / Map / Entity / Systems）是纯 C# 类，不引用任何 Godot 类型，
; 因此能在 dotnet test 与 --headless 自检里直接跑，和 TS 版「逻辑不依赖渲染」是同一个前提。
;
; 运行：
;   godot --headless --path godot --headless-selfcheck   （逻辑自检，不需要显卡）
;   godot --path godot                                    （正常启动游戏）

config_version=5

[application]

config/name="深渊回响"
config/description="房间制 Roguelike RPG · Godot 4 + C#"
run/main_scene="res://Scenes/Boot.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/show_image=false

[autoload]

; 存档与元进展：ConfigFile 落盘到 user://，对应 TS 版的 localStorage
GameStore="*res://Scripts/Autoload/GameStore.cs"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
; keep 而不是 expand：expand 会让视口尺寸跟着窗口走，
; 于是 1280x720 的布局在别的窗口比例下算出的坐标全不一样。
; keep 保证逻辑视口永远是 1280x720，多出来的边缘只是留黑。
window/stretch/aspect="keep"

[dotnet]

project/assembly_name="AbyssEcho"

[gui]

theme/default_font_multichannel_signed_distance_field=true

[input]

; 方向键 / WASD 都是移动：TS 版是 DOM keydown，这里换成 InputMap
move_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":87,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194320,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
